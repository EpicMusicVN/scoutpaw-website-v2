# =============================================================================
# TEMPLATE — DO NOT EDIT FOR RUNTIME
# -----------------------------------------------------------------------------
# This file lists the env vars the app expects. To use locally:
#   cp .env.local.example .env.local
# Then fill in your values in `.env.local` (gitignored).
# For Vercel: set values in the dashboard, not in any file.
# Never commit real secrets to this file.
# =============================================================================

# Content source — "json" (MVP) or "payload" (CMS; per-collection from Phase 2)
CONTENT_SOURCE=json

# Shopify mode — "mock" (MVP) or "live"
SHOPIFY_MODE=mock
# Bare host, no scheme. e.g. your-shop.myshopify.com
SHOPIFY_STORE_DOMAIN=
# Storefront API access token (shpss_...). Generated in Shopify Partners Dev
# Dashboard → your app → Storefront API access tokens. SERVER-ONLY here.
SHOPIFY_STOREFRONT_TOKEN=

# Newsletter mode — "stub" (MVP, logs to console) or "live" (Resend)
NEWSLETTER_MODE=stub

# Resend API — get key at https://resend.com/api-keys
RESEND_API_KEY=

# Where team notifications land when a user subscribes
TEAM_NOTIFICATION_EMAIL=

# Sender address — onboarding@resend.dev for zero-DNS testing,
# or a verified domain address (e.g., notifications@scoutpaw.tv) in prod
NEWSLETTER_FROM_EMAIL=onboarding@resend.dev

# Random secret for /api/newsletter/health diagnostic endpoint.
# Leave empty to disable the endpoint (returns 404).
# Generate: openssl rand -hex 16
DIAGNOSTIC_SECRET=

# Public site URL — canonical origin for metadataBase, canonical tags, sitemap,
# robots, and JSON-LD. MUST match the production canonical host (the live site
# serves on www, so use the www origin in prod). REQUIRED in production:
# lib/seo/site-url.ts throws if unset when VERCEL_ENV=production. Empty locally
# falls back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://www.scoutpaw.tv

# Analytics — GA4 measurement ID (G-XXXXXXXXXX). Cookie banner gates load.
NEXT_PUBLIC_GA_ID=

# Revalidation secret (for Shopify webhook, post-MVP)
REVALIDATE_SECRET=

# Cloudflare R2 public base URL for asset CDN (e.g., https://images.scoutpaw.tv/).
# Leave empty in dev to fall back to local /public/assets/.
NEXT_PUBLIC_R2_BASE_URL=

# YouTube Data API v3 key (server-only — NEVER use NEXT_PUBLIC_ prefix).
# Empty value falls back to JSON content for channel + video metadata.
# Production: restrict by HTTP referrer in Google Cloud Console.
YOUTUBE_API_KEY=

# =============================================================================
# Payload CMS (Phase 1+). Admin at /admin. SERVER-ONLY — never NEXT_PUBLIC_.
# =============================================================================

# Postgres (Neon). Use the POOLED connection string — required for Vercel
# serverless, else connections exhaust. Format: postgres://user:pass@host/db
DATABASE_URI=

# Payload signing secret. Generate: openssl rand -hex 32
PAYLOAD_SECRET=

# Cloudflare R2 (S3-compatible) for Payload media uploads.
# These are the R2 API credentials + bucket — distinct from the public CDN
# base URL (NEXT_PUBLIC_R2_BASE_URL above).
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=

# First admin user — consumed once by `pnpm seed:admin`, then can be removed.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
